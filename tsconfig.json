{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // Sin esto, el JSX compilado importa `jsx`/`jsxDEV` de "react/jsx-runtime" y el
    // wrapping que hace `cssInterop` (ver nativewindSetup.ts) nunca se activa: ese
    // wrapping vive en el createElement de "nativewind/jsx-runtime" (reexport de
    // react-native-css-interop), que intercepta cada elemento creado y sustituye
    // View/Text/etc. por la versión envuelta que sabe traducir `className`. Con el
    // runtime de JSX normal de React, `className` le llega a los componentes de
    // react-native-web tal cual y se descarta en silencio (no es una prop que
    // reenvíen). Esto es lo que hacía que Tailwind "no cargara" en la web pese a que
    // el CSS generado por @astrojs/tailwind era correcto.
    "jsxImportSource": "nativewind",
    "allowJs": true,
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*", "test/**/*", "nativewind-env.d.ts"]
}
