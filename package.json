{
  "name": "@javer-ia-nos/ui-shared",
  "version": "1.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/src/hooks/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/src/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/src/utils/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/src/components/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.73.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build:js": "bun build ./src/index.ts ./src/hooks/index.ts ./src/utils/index.ts ./src/types/index.ts ./src/components/index.ts --outdir ./dist --external react --external react-native",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir ./dist",
    "build": "bun run build:js && bun run build:types",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
